[Unit]
Description=Murojaatlar Telegram bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mjbot
Group=mjbot
WorkingDirectory=/opt/mj_bot
ExecStart=/opt/mj_bot/.venv/bin/python -B /opt/mj_bot/main.py
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mj_bot/data /opt/mj_bot/logs

[Install]
WantedBy=multi-user.target
